# Banco de dados --------------------------------------------------------------
# Local: deixe vazio para usar ./data/vault.db (criado e populado automaticamente).
# Produção (Vercel): use um banco libSQL/Turso, ex. libsql://vault-association.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Popular pedidos/clientes/analytics de demonstração no primeiro boot (true/false)
SEED_DEMO_DATA=true

# Admin criado no primeiro boot ---------------------------------------------------
ADMIN_EMAIL=admin@vaultassociation.com
ADMIN_PASSWORD=vault-admin

# Sessão do painel. Se vazio, um segredo aleatório é gerado e salvo no banco.
SESSION_SECRET=

# URL pública (links de redefinição de senha, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de recuperação de senha via Resend (opcional). Sem isso, o link é
# registrado no log do servidor (e exibido na tela em desenvolvimento).
RESEND_API_KEY=
RESET_EMAIL_FROM="Vault Association <no-reply@vaultassociation.com>"
